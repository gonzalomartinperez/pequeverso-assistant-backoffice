# Runtime configuration for pequeverso-assistant-web. Read by the server per request, so one image
# serves every environment; changing a value needs a restart, not a rebuild. No secrets belong here:
# the browser never holds API keys, and the session cookie is issued by the API.

# Exact origins allowed to frame /embed (comma-separated, max 8, https only; http only for
# localhost). Empty = embedding denied. Verified production storefront origin: https://pequeverso.com
EMBED_ALLOWED_ORIGINS=http://localhost:3210

# Storefront origin for product, purchase, support and image URLs. Default: https://pequeverso.com
STOREFRONT_ORIGIN=http://localhost:3210

# Extra https hosts allowed for informational links (matches the API catalog allowlist).
ASSISTANT_LINK_HOSTS=consumer.hotmart.com,refund.hotmart.com

# Standard Next.js server settings (the image sets these).
# PORT=3000
# HOSTNAME=0.0.0.0
