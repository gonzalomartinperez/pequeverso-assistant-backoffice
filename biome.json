{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!package-lock.json",
      "!next-env.d.ts",
      "!public",
      "!contracts/ops/ops.schema.json",
      "!contracts/ops/ops.summary.example.json",
      "!contracts/telemetry/ops.telemetry.schema.json",
      "!contracts/telemetry/ops.telemetry.example.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true,
      "cssModules": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["docs/architecture/system-light.svg", "docs/architecture/system-dark.svg"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "a11y": {
            "noRedundantRoles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
