{
  "name": "pequeverso-assistant-backoffice",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --port 3201",
    "build": "next build --webpack",
    "start": "next start --port 3201",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:browser": "playwright test",
    "security:check": "node scripts/check-public-files.ts",
    "docs:check": "node scripts/check-docs.ts",
    "skills:check": "node scripts/check-skills.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run security:check && npm run docs:check && npm run skills:check && npm run build",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\"",
    "preview:backoffice": "node scripts/backoffice-stack.ts",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:check": "node scripts/db-check.ts",
    "test:db": "node scripts/db-check.ts && npm run test:integration"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
